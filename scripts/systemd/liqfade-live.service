[Unit]
Description=liqfade trading loop
Documentation=file:/srv/liqfade/app/CLAUDE.md
After=network-online.target chrony.service liqfade-recorder.service
Wants=network-online.target
Requires=liqfade-recorder.service

[Service]
Type=simple
# The kill switch wins over systemd too: the unit refuses to start while the flag exists,
# so a restart loop cannot walk past a kill the owner triggered.
ExecStartPre=/usr/bin/test ! -e /srv/liqfade/data/KILL
ExecStart=/home/liqfade/.local/bin/uv run --frozen liqfade live
User=liqfade
Group=liqfade
EnvironmentFile=/srv/liqfade/.env
# Its own control socket and state file. The recorder runs 24/7 on the same box and the
# server takes an exclusive flock on its socket, so without these the second unit to
# start refuses outright rather than stealing the first one's socket and answering /kill
# for a process with nothing at risk.
Environment=LIQFADE_CONTROL__SOCKET_PATH=control-live.sock
Environment=LIQFADE_CONTROL__STATE_FILE=state-live.json
WorkingDirectory=/srv/liqfade/app
Restart=always
RestartSec=3
LimitNOFILE=65536

# Hardening. The code directory stays read only; only data and logs are writable.
# ProtectHome is read-only rather than yes because ExecStart lives under /home: yes empties
# /home inside the namespace, so systemd cannot execute uv and the unit dies at 203/EXEC.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/srv/liqfade/data /srv/liqfade/logs

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
