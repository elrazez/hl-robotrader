[Unit]
Description=liqfade market data recorder
Documentation=file:/srv/liqfade/app/docs/DATA_SOURCES.md
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/srv/liqfade/app/.venv/bin/liqfade record
User=liqfade
Group=liqfade
EnvironmentFile=/srv/liqfade/.env
WorkingDirectory=/srv/liqfade/app
Restart=always
RestartSec=3
LimitNOFILE=65536

# Hardening. The code directory stays read only; only data and logs are writable.
# The unit runs the venv deploy.sh synced, not `uv run`: uv wants a writable cache under
# /home at every start, and nothing under /home is writable here.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/srv/liqfade/data /srv/liqfade/logs

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
