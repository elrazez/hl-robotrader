# Secrets
.env
.env.*
!.env.example

# Data lake and run artifacts
/data/
# Run outputs stay out. The two Phase 3 documents that are promises rather than
# outputs are tracked: the preregistration has to be committed before the first run
# for its hash to mean anything, and SUMMARY.md ships as a template.
/reports/*
!/reports/research/
/reports/research/*
!/reports/research/PREREGISTRATION.md
!/reports/research/SUMMARY.md
/logs/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Panel overrides written at runtime by the panel
config/overrides.yaml

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Node (the built bundle under liqfade/panel/static/ IS committed on purpose)
node_modules/
liqfade/panel/frontend/dist/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Vite/tsc build metadata
*.tsbuildinfo

# Playwright MCP scratch output
.playwright-mcp/
