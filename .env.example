# Copy to .env on the VPS only. Never commit .env. Never paste real values into chat.
# On the VPS this lives at /srv/liqfade/.env, mode 0600, owned by the liqfade user.
#
# Every variable the code reads is listed here. Config keys can also be overridden with
# LIQFADE_SECTION__KEY, for example LIQFADE_SIZING__RISK_FRAC=0.004.

# Environment: paper | testnet | mainnet
LIQFADE_ENV=paper
# Must be exactly "1" AND LIQFADE_ENV=mainnet AND no data/KILL file for any real order.
# Leave unset otherwise.
LIQFADE_LIVE_TRADING=

# Hyperliquid mainnet (main wallet address is public; agent key is secret)
HL_MAINNET_ACCOUNT_ADDRESS=0x
HL_MAINNET_AGENT_PRIVATE_KEY=

# Hyperliquid testnet
HL_TESTNET_ACCOUNT_ADDRESS=0x
HL_TESTNET_AGENT_PRIVATE_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to send commands
TELEGRAM_ALLOWED_CHAT_IDS=
# Chat id that receives alerts
TELEGRAM_ALERT_CHAT_ID=

# Coinalyze (free)
COINALYZE_API_KEY=

# AWS for requester-pays S3 pulls (read-only IAM user)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1

# Data lake root. Overrides paths.data_dir.
LIQFADE_DATA_DIR=/srv/liqfade/data

# Control socket path, relative to the data dir unless absolute. Overrides
# control.socket_path. Keep the full path under 100 bytes: it is a unix socket.
LIQFADE_CONTROL_SOCKET=control.sock

# Web panel. Generate the hash with `liqfade panel hash-password`; it is a bcrypt hash,
# not the password. Without it the panel refuses to start.
LIQFADE_PANEL_PASSWORD_HASH=
# Optional. Set it to keep panel sessions alive across restarts. Any long random string.
# Leave unset and every panel restart forces a fresh login, which is the safer default.
LIQFADE_PANEL_SESSION_SECRET=

# rsync target for `liqfade sync`, set on the LAPTOP, not the VPS. Overrides sync.host.
LIQFADE_SYNC_HOST=

# Watchdog (liqfade-watchdog.service sets these; listed here because the code reads them).
# The heartbeat file it watches. Unset means the loop's own path under the data dir.
# LIQFADE_WATCH_HEARTBEAT=
# Seconds of silence before it pages. The loop writes every second, so 10 is nine misses.
# LIQFADE_WATCH_STALE_S=10
# What the alert calls the process it is watching.
# LIQFADE_WATCH_LABEL=paper loop

# Optional overrides
# LIQFADE_LOG_LEVEL=INFO
# LIQFADE_CONFIG_DIR=/srv/liqfade/app/config
