# Copy to .env on the VPS only. Never commit .env. Never paste real values into chat.

# Environment: paper | testnet | mainnet
LIQFADE_ENV=paper
# Must be exactly "1" AND LIQFADE_ENV=mainnet for any real order. Leave unset otherwise.
LIQFADE_LIVE_TRADING=

# Hyperliquid mainnet (main wallet address is public; agent key is secret)
HL_MAINNET_ACCOUNT_ADDRESS=0x
HL_MAINNET_AGENT_PRIVATE_KEY=

# Hyperliquid testnet
HL_TESTNET_ACCOUNT_ADDRESS=0x
HL_TESTNET_AGENT_PRIVATE_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to send commands
TELEGRAM_ALLOWED_CHAT_IDS=
# Chat id that receives alerts
TELEGRAM_ALERT_CHAT_ID=

# Coinalyze (free)
COINALYZE_API_KEY=

# AWS for requester-pays S3 pulls (read-only IAM user)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1

# Data lake root
LIQFADE_DATA_DIR=/srv/liqfade/data
